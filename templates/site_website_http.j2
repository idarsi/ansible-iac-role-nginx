server {
  listen 80;
  server_name {{ nginx_site.name }};
  index index.html;
  root {{ nginx_www_directory }}/{{ nginx_site.name }}/html;
{% if nginx_render_locations | default(true) and nginx_site.locations is defined %}
{% for location in nginx_site.locations %}
  location {{ location.path }} {
{% for directive, value in location.items() if directive not in ['path', 'autoconfigure', 'redirect_to'] and value is not none %}
{% if directive == 'proxy_set_header' and value is iterable and value is not string %}
{% for header in value %}
    {{ directive }} {{ header }};
{% endfor %}
{% else %}
    {{ directive }} {{ value }};
{% endif %}
{% endfor %}
  }
{% endfor %}
{% endif %}
}
